# ==============================================================================
# Anceva Bot — пример окружения
# Скопируй в .env и заполни значениями. .env не коммитится.
# ==============================================================================

# -- Application ---------------------------------------------------------------
ENV=local                                  # local | staging | production
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                         # console | json
TZ=Asia/Qyzylorda                          # Караганда — UTC+5

# -- Telegram ------------------------------------------------------------------
BOT_TOKEN_CLIENT=                          # токен клиентского бота (@BotFather)
BOT_TOKEN_ADMIN=                           # токен админ-пульта
BOT_WEBHOOK_URL=                           # https://anceva.example/webhook (пусто = long polling)
BOT_WEBHOOK_SECRET=                        # секрет-токен для валидации webhook
BOT_USERNAME_CLIENT=anceva_bot             # без @, используется в deeplinks
BOT_USERNAME_ADMIN=anceva_admin_bot

# -- LLM -----------------------------------------------------------------------
GEMINI_API_KEY=                            # ключ из Google AI Studio
GEMINI_MODEL_MAIN=gemini-2.0-flash
GEMINI_MODEL_LITE=gemini-2.0-flash-lite
GEMINI_MODEL_HEAVY=gemini-2.5-pro
GEMINI_TIMEOUT_SEC=30

# -- Database ------------------------------------------------------------------
# SQLite на старте. В проде — Postgres: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./var/anceva.sqlite

# -- Web admin -----------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_BASE_URL=http://localhost:8000         # полный URL для обратных ссылок
WEB_SESSION_SECRET=                        # случайная длинная строка (openssl rand -hex 32)
MINIAPP_BASE_URL=http://localhost:8000/app # база Mini App (HTTPS в продакшене обязателен)

# -- Admins --------------------------------------------------------------------
# Telegram user_id владельца (получить: написать @userinfobot)
# Первый admin seed'ится в БД при запуске, дальше через веб-админку
OWNER_TG_USER_ID=

# -- Kaspi ---------------------------------------------------------------------
# Свою ссылку возьмёшь в приложении Kaspi: раздел «Мой Kaspi» → «Переводы» → «QR на оплату»
KASPI_PAY_LINK=
KASPI_MERCHANT_NAME=Центр Коррекции Речи Анцевой М.С.

# -- Sentry --------------------------------------------------------------------
SENTRY_DSN=                                # опционально, но рекомендуется в проде
SENTRY_TRACES_SAMPLE_RATE=0.1

# -- Feature flags -------------------------------------------------------------
FEATURE_SHADOW_MODE=true                   # первые недели: бот пишет черновик, админ одобряет
FEATURE_AUTO_INVOICE=false                 # автогенерация счетов 1-го числа
FEATURE_KASPI_OCR=false                    # распознавание сумм из фото чеков
